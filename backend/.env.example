# ---------------------------------------------------------------------------
# SafeWay AI backend configuration
#
# Copy to `backend/.env` and adjust. Never commit real secrets.
# Every key below maps 1:1 onto a field in app/core/config.py - unknown keys
# are ignored, so keep this file in sync when you add settings.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_NAME=SafeWay AI
APP_VERSION=1.0.0
ENVIRONMENT=development            # development | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# Browser origins allowed to call the API directly. When the frontend is served
# through nginx on the same origin, this only needs to list that origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting PII (phone, licence, emergency contact) at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty only for local demos - the app then derives an ephemeral key and
# encrypted values cannot be decrypted after a restart.
FIELD_ENCRYPTION_KEY=

# --- Database ---------------------------------------------------------------
# SQLite by default. For production use PostgreSQL, e.g.
#   postgresql+psycopg://safeway:password@db:5432/safeway
DATABASE_URL=sqlite:///./data/safeway.db

# --- Redis (optional) -------------------------------------------------------
# Used for rate-limit counters and WebSocket fan-out when configured.
# Leave empty to use in-process fallbacks (single-instance deployments only).
REDIS_URL=

# --- AI / LLM (server-side only) -------------------------------------------
# When LLM_API_KEY is empty the assistant runs in a transparent local
# rule-based mode. Keys are never sent to the browser.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
RISK_MODEL_VERSION=risk-hgb-1.0.0
SCORING_MODEL_VERSION=score-exp-1.1.0

# --- Weather (optional) -----------------------------------------------------
# When empty the road-safety page shows a clearly labelled simulated sample
# instead of fabricating live conditions.
WEATHER_API_KEY=

# --- Notifications ----------------------------------------------------------
# Email and SMS are stubbed unless these are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@safeway.local
SMS_PROVIDER=none
SMS_API_KEY=

# --- Demo / simulation ------------------------------------------------------
# DEMO_MODE gates the simulator; SEED_DEMO_DATA seeds a demo organisation on an
# empty database. Set both false in production unless the deployment is
# explicitly a demo environment.
DEMO_MODE=true
SEED_DEMO_DATA=true
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=3
SIMULATOR_VEHICLE_COUNT=6

# --- Retention & limits -----------------------------------------------------
DATA_RETENTION_DAYS=365
RATE_LIMIT_PER_MINUTE=300
