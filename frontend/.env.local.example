# SafeWay AI frontend configuration.
# Copy to `.env.local`. All values here are safe to expose to the browser.

# Where the browser should send API requests. Leave unset in production so the
# same origin (nginx) proxies /api/* to the backend.
NEXT_PUBLIC_API_BASE=/api/v1

# WebSocket endpoint for live tracking. Leave unset to use the current origin.
NEXT_PUBLIC_WS_URL=

# Server-side only: the Next.js rewrite target for /api/v1/* requests.
API_PROXY_URL=http://localhost:8000
